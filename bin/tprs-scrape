#!/usr/bin/env python3
"""tprs-scrape — reusable CLI for the TPRS public-curriculum scraper.

Wraps the two-phase pipeline (tprs.crawl -> tprs.download) behind one entry point.
Public content on portal.tprsbooks.com is server-rendered HTML behind a WP Engine
anti-bot wall; this tool uses cloudscraper, NOT a headless browser. See the
"Scraping Protocol" section of CLAUDE.md for why $B / Playwright / Firecrawl do
not work here.

Usage:
    bin/tprs-scrape crawl                 # Phase 1: build out/manifest.json (no downloads)
    bin/tprs-scrape download [opts]       # Phase 2: download from the manifest
    bin/tprs-scrape all [opts]            # crawl, then download
    bin/tprs-scrape probe                 # smoke-test the WPE bypass (1 request)

download/all options (passed through to tprs.download):
    --limit N        stop after N downloads (smoke test)
    --chapter N      only this chapter
    --section NAME   only this section (e.g. Slides)
    --sleep S        delay between downloads (default 0.4)
"""
import os
import runpy
import sys

# Make the repo root importable so `import tprs` works no matter the CWD.
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)


def _run(module, argv):
    """Invoke a tprs module's main() with the given argv."""
    sys.argv = [module] + argv
    runpy.run_module(module, run_name="__main__")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = args[0], args[1:]

    if cmd == "crawl":
        _run("tprs.crawl", rest)
    elif cmd == "download":
        _run("tprs.download", rest)
    elif cmd == "all":
        _run("tprs.crawl", [])
        _run("tprs.download", rest)
    elif cmd == "probe":
        from tprs import common
        s = common.make_session()
        r = common.get(s, "https://portal.tprsbooks.com/wp-sitemap.xml")
        n = r.text.count("<loc>")
        print(f"WPE bypass OK via cloudscraper: HTTP 200, {n} sub-sitemaps visible.")
    else:
        print(f"unknown command: {cmd}\n", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
